{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mullvad Adapter",
  "version": "0.1.0",
  "identifier": "local.mullvad.adapter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mullvad Adapter",
        "width": 1060,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
